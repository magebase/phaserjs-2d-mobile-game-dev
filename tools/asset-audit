#!/usr/bin/env python3
"""CLI utility to audit textures, spritesheets, audio, and fonts in a Phaser 4 game."""

import argparse
import json
import sys
from pathlib import Path

# Add repo root to python path
repo_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(repo_root))

from tools.lib.asset_analyzer import analyze_assets
from tools.lib.common import save_json, validate_schema


def main():
    parser = argparse.ArgumentParser(description="Audit visual and audio assets in a game project")
    parser.add_argument("path", nargs="?", default=".", help="Root directory of the game project")
    parser.add_argument("-o", "--output", default="asset-catalog.json", help="Output path for asset-catalog.json")
    parser.add_argument("--validate", action="store_true", default=True, help="Validate against schema")
    args = parser.parse_args()

    target = Path(args.path).resolve()
    if not target.is_dir():
        print(f"Error: Target path '{target}' is not a directory", file=sys.stderr)
        sys.exit(1)

    print(f"Auditing assets in: {target}...")
    catalog = analyze_assets(target)

    out_file = Path(args.output)
    if not out_file.is_absolute():
        out_file = target / out_file

    save_json(catalog, out_file)
    print(f"Asset catalog written to: {out_file}")
    print(f"Total files: {catalog['total_files']}, Defects found: {catalog['summary']['defect_count']}")

    if args.validate:
        schema_file = repo_root / "schemas" / "asset-catalog.schema.json"
        if schema_file.exists():
            valid, err = validate_schema(catalog, schema_file)
            if not valid:
                print(f"Warning: Schema validation failed: {err}", file=sys.stderr)
            else:
                print("Asset catalog matches schema successfully.")


if __name__ == "__main__":
    main()
